{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TOPA",
  "version": "0.1.3",
  "identifier": "io.github.kaualimadesouza.topa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TOPA",
        "width": 820,
        "height": 1180,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 1,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

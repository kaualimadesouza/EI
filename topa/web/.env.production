# Public on purpose: every VITE_ value ships in the JS bundle, so never put a secret here.
# Every production build (Vercel, Tauri) talks to the one API; web.yml empties it for PR previews,
# whose URLs are not in the API's CORS list. No trailing slash: routes are appended as `/products`.
VITE_API_URL=https://emxfjyvjn4.execute-api.us-east-1.amazonaws.com
